# Hearth — safe local configuration example (no real secrets).
# Copy to your shell profile or a local .env file. NEVER commit real keys.
#
# Generate a strong admin key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# HEARTH_* names take precedence. Older BRIDGE_* (and HOST/PORT) names still
# work, so gemini-stealth-bridge setups keep running unchanged.

# Bind address. KEEP loopback. The daemon refuses non-loopback binds.
HEARTH_HOST=127.0.0.1

# Listen port.
HEARTH_PORT=20133

# Data directory for accounts/*.json and session-cache.json.
# First run auto-copies accounts from ~/.gemini-stealth-bridge (if present).
HEARTH_HOME=~/.hearth

# Admin bearer token for /v1/accounts, /v1/quota, /v1/sessions, /v1/refresh,
# /metrics. Must be >= 16 random characters. Leave empty ONLY if you do not
# need admin endpoints (they will deny all). NEVER use "public".
HEARTH_API_KEY=

# Per-account tokens (auto-populated from accounts/*.json as
# hearth-<id>,<id>; legacy gsb-<id> also accepted).
# Set explicitly ONLY to lock the token set and disable auto-registration.
# HEARTH_ACCOUNT_TOKENS=hearth-acc1:acc1,acc1:acc1

# Outbound proxy for Gemini upstream traffic (optional).
# HEARTH_PROXY_SERVER=http://127.0.0.1:8080

# Log verbosity: info (default), error, silent.
HEARTH_LOG_LEVEL=info
