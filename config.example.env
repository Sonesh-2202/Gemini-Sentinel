# Gemini-Sentinel — safe local configuration example (no real secrets).
#
# NOTE: `sentinel --setup` generates and saves safe defaults into
# ~/.gemini-sentinel/.env (loaded automatically on every run) — you usually
# don't need any manual exports at all. Explicit environment variables
# always win over the file contents.
#
# Generate a strong admin key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# SENTINEL_* is the only supported env prefix (plus HOST/PORT).

# Bind address. KEEP loopback. The daemon refuses non-loopback binds.
SENTINEL_HOST=127.0.0.1

# Listen port.
SENTINEL_PORT=20133

# Data directory for accounts/*.json, .env and session-cache.json.
SENTINEL_HOME=~/.gemini-sentinel

# Admin bearer token for /v1/accounts, /v1/quota, /v1/sessions, /v1/refresh,
# /metrics. Must be >= 16 random characters. Leave empty ONLY if you do not
# need admin endpoints (they will deny all). NEVER use "public".
SENTINEL_API_KEY=

# Per-account tokens (auto-populated from accounts/*.json as
# sentinel-<id>,<id>).
# Set explicitly ONLY to lock the token set and disable auto-registration.
# SENTINEL_ACCOUNT_TOKENS=sentinel-acc1:acc1,acc1:acc1

# Outbound proxy for Gemini upstream traffic (optional).
# SENTINEL_PROXY_SERVER=http://127.0.0.1:8080

# Log verbosity: info (default), error, silent.
SENTINEL_LOG_LEVEL=info
