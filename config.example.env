# Safe local configuration example (no real secrets).
# Copy to your shell profile or a local .env file. NEVER commit real keys.
#
# Generate a strong admin key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

# Bind address. KEEP loopback. The daemon refuses non-loopback binds.
HOST=127.0.0.1
BRIDGE_HOST=127.0.0.1

# Listen port.
PORT=20133
BRIDGE_PORT=20133

# Data directory for accounts/*.json and session-cache.json.
BRIDGE_HOME=~/.gemini-stealth-bridge

# Admin bearer token for /v1/accounts, /v1/quota, /v1/sessions, /v1/refresh.
# REQUIRED for admin endpoints; must be >= 16 random characters.
# Leave empty ONLY if you do not need admin endpoints (they will deny all).
# NEVER use "public" or any placeholder.
BRIDGE_API_KEY=

# Per-account tokens (auto-populated from accounts/*.json as gsb-<id>,<id>).
# Set explicitly ONLY to lock the token set and disable auto-registration.
# BRIDGE_ACCOUNT_TOKENS=gsb-acc1:acc1,acc1:acc1

# Outbound proxy for Gemini upstream traffic (optional).
# BRIDGE_PROXY_SERVER=http://127.0.0.1:8080

# Log verbosity: info (default), error, silent.
BRIDGE_LOG_LEVEL=info
